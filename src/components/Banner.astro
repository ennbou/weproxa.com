---
import { Icon } from '@astrojs/starlight/components';
const { banner } = Astro.locals.starlightRoute.entry.data;
---

<aside class="announcement-banner" aria-label="Linux support announcement" data-pagefind-ignore>
  <div class="announcement-banner__inner">
    <div class="announcement-banner__message">
      <span class="announcement-banner__icon">
        <Icon name="linux" size="1.5rem" />
      </span>
      <div class="announcement-banner__copy">
        <div class="announcement-banner__heading">
          <strong>Linux support is here</strong>
          <span class="announcement-banner__badge">Preview</span>
        </div>
        <p>WePROXA 3.11.0 · .deb &amp; .rpm · x86_64 &amp; ARM64</p>
      </div>
    </div>
    <a class="announcement-banner__link" href="/guide/getting-started/installation-linux/">
      Install on Linux
      <Icon name="right-arrow" class="announcement-banner__arrow" />
    </a>
  </div>
</aside>

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

<style>
  @layer starlight.core {
    .announcement-banner {
      padding: 0.875rem var(--sl-nav-pad-x);
      background:
        radial-gradient(
          ellipse at 30% 0%,
          color-mix(in srgb, var(--sl-color-accent), transparent 88%),
          transparent 75%
        ),
        var(--sl-color-bg);
      border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent), transparent 78%);
      color: var(--sl-color-white);
    }

    .announcement-banner__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.875rem 2rem;
      max-width: 72rem;
      margin-inline: auto;
    }

    .announcement-banner__message {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      min-width: 0;
    }

    .announcement-banner__icon {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-accent), transparent 72%);
      border-radius: 0.875rem;
      background: color-mix(in srgb, var(--sl-color-accent), transparent 90%);
      color: var(--sl-color-accent-high);
    }

    .announcement-banner__copy {
      min-width: 0;
    }

    .announcement-banner__heading {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.375rem 0.625rem;
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .announcement-banner__heading strong {
      font-weight: 650;
      letter-spacing: -0.015em;
    }

    .announcement-banner__badge {
      padding: 0.0625rem 0.4375rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-accent), transparent 68%);
      border-radius: 0.375rem;
      background: color-mix(in srgb, var(--sl-color-accent), transparent 90%);
      color: var(--sl-color-accent-high);
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .announcement-banner__copy p {
      margin: 0.125rem 0 0;
      color: var(--sl-color-gray-2);
      font-size: 0.8125rem;
      line-height: 1.6;
      text-wrap: pretty;
    }

    .announcement-banner__link {
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 2.5rem;
      margin: 0;
      padding: 0.5rem 0.875rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-accent), transparent 64%);
      border-radius: 0.625rem;
      background: color-mix(in srgb, var(--sl-color-accent), transparent 90%);
      color: var(--sl-color-accent-high);
      font-size: 0.8125rem;
      font-weight: 600;
      line-height: 1.5;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 150ms ease, border-color 150ms ease;
    }

    .announcement-banner__link:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent), transparent 35%);
      background: color-mix(in srgb, var(--sl-color-accent), transparent 80%);
    }

    .announcement-banner__link:focus-visible {
      outline: 2px solid var(--sl-color-accent-high);
      outline-offset: 3px;
    }

    .announcement-banner__link :global(.announcement-banner__arrow) {
      transition: transform 150ms ease;
    }

    .announcement-banner__link:hover :global(.announcement-banner__arrow) {
      transform: translateX(2px);
    }

    .sl-banner {
      --__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
      color: var(--__sl-banner-text);
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      box-shadow: var(--sl-shadow-sm);
    }

    .sl-banner :global(a) {
      color: var(--__sl-banner-text);
    }

    @media (max-width: 40rem) {
      .announcement-banner__inner {
        justify-content: space-between;
        gap: 0.75rem;
      }

      .announcement-banner__message {
        flex: 1 1 16rem;
        gap: 0.625rem;
      }

      .announcement-banner__link {
        min-height: 2.75rem;
      }
    }

    @media (max-width: 30rem) {
      .announcement-banner__link {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .announcement-banner__link,
      .announcement-banner__link :global(.announcement-banner__arrow) {
        transition: none;
      }
    }
  }
</style>
