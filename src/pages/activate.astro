---
const pageTitle = 'Activate WePROXA';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#111827" />
    <meta
      name="description"
      content="Open WePROXA and activate your license after purchase."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="activation-shell">
      <a class="brand" href="/" aria-label="WePROXA home">
        <img src="/favicon.svg" alt="" width="32" height="32" />
        <span>WePROXA</span>
      </a>

      <section class="activation-card" aria-labelledby="activation-title">
        <div class="app-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path
              d="M12 3a9 9 0 1 0 9 9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
            <path
              d="m13.5 7.5 4 4-4 4M17.5 11.5H8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </div>

        <p class="eyebrow">License activation</p>
        <h1 id="activation-title">Opening WePROXA…</h1>
        <p id="activation-status" class="status" role="status" aria-live="polite">
          Your purchase is complete. We’re sending your license securely to the app.
        </p>

        <a
          id="activate-button"
          class="primary-button"
          href="/"
          aria-disabled="true"
        >
          Open WePROXA
        </a>

        <p id="activation-help" class="help">
          If the app does not open, make sure WePROXA is installed, then use the button above.
        </p>

        <a class="download-link" href="/guide/getting-started/installation/">
          Download WePROXA
        </a>
      </section>

      <p class="privacy-note">Your license key is never displayed on this page.</p>
    </main>

    <script>
      const activationTitle = document.querySelector('#activation-title');
      const activationStatus = document.querySelector('#activation-status');
      const activationButton = document.querySelector('#activate-button');
      const activationHelp = document.querySelector('#activation-help');

      const pageUrl = new URL(window.location.href);
      const queryKey = pageUrl.searchParams.get('key')?.trim();
      const hashParams = new URLSearchParams(pageUrl.hash.slice(1));
      const hashKey = hashParams.get('key')?.trim();
      const licenseKey = queryKey || hashKey;

      if (
        activationTitle instanceof HTMLElement &&
        activationStatus instanceof HTMLElement &&
        activationButton instanceof HTMLAnchorElement &&
        activationHelp instanceof HTMLElement
      ) {
        if (!licenseKey || licenseKey.length > 512) {
          activationTitle.textContent = 'Activation link incomplete';
          activationStatus.textContent =
            'This link does not contain a valid license key. Open your Lemon Squeezy receipt and try the activation button again.';
          activationButton.textContent = 'Open license settings';
          activationButton.href = 'weproxa://settings/license';
          activationButton.removeAttribute('aria-disabled');
          activationHelp.textContent =
            'You can also copy the license key from your receipt and enter it in WePROXA Settings → License.';
        } else {
          const deepLink = `weproxa://activate?key=${encodeURIComponent(licenseKey)}`;

          activationButton.href = deepLink;
          activationButton.removeAttribute('aria-disabled');
          activationButton.addEventListener('click', () => {
            activationTitle.textContent = 'Opening WePROXA…';
            activationStatus.textContent = 'Approve the browser prompt to continue activation.';
          });

          window.setTimeout(() => {
            window.location.assign(deepLink);

            window.setTimeout(() => {
              activationTitle.textContent = 'Did WePROXA open?';
              activationStatus.textContent =
                'If nothing happened, click Open WePROXA below to try again.';
            }, 1200);
          }, 250);
        }
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #080c14;
    color: #f8fafc;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 20rem;
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(57, 189, 248, 0.18), transparent 34rem),
      radial-gradient(circle at 100% 100%, rgba(124, 58, 237, 0.1), transparent 32rem),
      #080c14;
  }

  body::before {
    position: fixed;
    inset: 0;
    content: "";
    pointer-events: none;
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: linear-gradient(to bottom, black, transparent 76%);
  }

  .activation-shell {
    position: relative;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.5rem;
    color: #f8fafc;
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img {
    margin-right: 0.65rem;
  }

  .activation-card {
    width: min(100%, 31rem);
    padding: clamp(1.75rem, 6vw, 3rem);
    text-align: center;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 1.5rem;
    background: rgba(15, 23, 42, 0.8);
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.42),
      inset 0 1px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(1.25rem);
  }

  .app-icon {
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.5rem;
    place-items: center;
    color: #7dd3fc;
    border: 1px solid rgba(125, 211, 252, 0.25);
    border-radius: 1.25rem;
    background: linear-gradient(145deg, rgba(14, 165, 233, 0.2), rgba(30, 41, 59, 0.55));
    box-shadow:
      0 1rem 2.5rem rgba(14, 165, 233, 0.16),
      inset 0 1px rgba(255, 255, 255, 0.08);
  }

  .app-icon svg {
    width: 2.35rem;
    height: 2.35rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #7dd3fc;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #f8fafc;
    font-size: clamp(1.8rem, 7vw, 2.35rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .status {
    max-width: 25rem;
    min-height: 4.8rem;
    margin: 1rem auto 1.5rem;
    color: #cbd5e1;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .primary-button {
    display: inline-flex;
    width: 100%;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    color: #082f49;
    font-size: 0.96rem;
    font-weight: 750;
    text-decoration: none;
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #bae6fd, #38bdf8);
    box-shadow: 0 1rem 2rem -1rem rgba(56, 189, 248, 0.65);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      filter 160ms ease;
  }

  .primary-button:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
    box-shadow: 0 1.15rem 2.2rem -1rem rgba(56, 189, 248, 0.8);
  }

  .primary-button:focus-visible,
  .download-link:focus-visible,
  .brand:focus-visible {
    outline: 3px solid rgba(125, 211, 252, 0.7);
    outline-offset: 3px;
  }

  .primary-button[aria-disabled="true"] {
    pointer-events: none;
    opacity: 0.55;
  }

  .help {
    margin: 1rem 0 0;
    color: #94a3b8;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .download-link {
    display: inline-block;
    margin-top: 0.9rem;
    color: #bae6fd;
    font-size: 0.84rem;
    font-weight: 650;
    text-underline-offset: 0.2rem;
  }

  .privacy-note {
    margin: 1.25rem 0 0;
    color: #64748b;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .activation-card {
      animation: card-in 440ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .app-icon {
      animation: icon-in 520ms 80ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes icon-in {
    from {
      opacity: 0;
      transform: scale(0.86);
    }
  }

  @media (max-width: 30rem) {
    .activation-card {
      padding: 1.5rem 1.25rem;
      border-radius: 1.1rem;
    }
  }
</style>
